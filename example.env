# #######################################
# BOT CORE              #
# #######################################

# Primary Discord bot token.
# Obtain this from the Discord Developer Portal:
# https://discord.com/developers/applications
# 
# IMPORTANT:
# - Never share this token publicly.
# - Never commit it to GitHub.
# - Regenerate it immediately if exposed.
# 
# Example:
# TOKEN='YOUR_BOT_TOKEN_HERE'
TOKEN=''

# Default prefix for message-based (non-slash) commands.
# Only required if your bot supports traditional prefix commands.
# 
# Example:
# PREFIX='!'
PREFIX='!'

# Delete all registered slash commands every time the bot starts.
# Useful during development to force re-registration.
# 
# ⚠ Not recommended in production environments
# as it may cause rate limits and temporary command loss.
# 
# true  → Delete commands on startup
# false → Keep existing registered commands
# 
# Example:
# DELETE_COMMANDS='true'
DELETE_COMMANDS='false'


# #######################################
# BOT STATUS CONFIG          #
# #######################################

# Activity messages displayed in the bot's presence.
# Must be a valid JSON array of strings.
# 
# Supported dynamic placeholders:
# {members}             → Total users across all guilds
# {servers}             → Total number of guilds
# {usedCommands}        → Total executed commands
# {joinedVoiceChannels} → Total joined voice channels
# {prefix}              → Current command prefix
# 
# Example:
# STATUS_ACTIVITY='["Serving {members} users", "Active in {servers} servers"]'
STATUS_ACTIVITY='[]'

# Activity types corresponding to each STATUS_ACTIVITY entry.
# Must be a JSON array with the same length as STATUS_ACTIVITY.
# 
# Available values:
# Competing | Listening | Playing | Streaming | Watching | Custom
# 
# Example:
# STATUS_TYPE='["Playing", "Watching"]'
STATUS_TYPE='[]'

# Presence status corresponding to each activity entry.
# Must match the length of STATUS_ACTIVITY.
# 
# Available values:
# online | idle | dnd | offline
# 
# Example:
# STATUS_PRESENCE='["online", "idle"]'
STATUS_PRESENCE='[]'


# #######################################
# DATABASE CONFIG          #
# #######################################

# Database engine used for persistent storage.
# 
# Available options:
# mysql     → MySQL server
# sql       → Local SQL-based database
# mongodb   → MongoDB (recommended for scalability)
# json      → Local JSON file (development only)
# 
# Example:
# DATABASE_TYPE='json'
DATABASE_TYPE='json'

# MongoDB connection string.
# Required if DATABASE_TYPE='mongodb'.
# 
# Example:
# DATABASE_MONGO_URL='mongodb+srv://user:password@cluster.mongodb.net/database'
DATABASE_MONGO_URL=''

# MySQL configuration.
# Required if DATABASE_TYPE='mysql'.

# MySQL server host (IP or domain).
# Example:
# DATABASE_MYSQL_HOST='localhost'
DATABASE_MYSQL_HOST=''

# MySQL username.
# Example:
# DATABASE_MYSQL_USER='root'
DATABASE_MYSQL_USER=''

# MySQL password.
# Example:
# DATABASE_MYSQL_PASSWORD='strong_password'
DATABASE_MYSQL_PASSWORD=''

# MySQL database name.
# Example:
# DATABASE_MYSQL_NAME='bot_database'
DATABASE_MYSQL_NAME=''


# #######################################
# SUPPORT INFORMATION        #
# #######################################

# Official support server ID.
# Used for internal logging and status reporting.
# 
# Example:
# SUPPORT_SERVER_ID='123456789012345678'
SUPPORT_SERVER_ID=''

# Permanent invite link to the support server.
# Must not expire.
# 
# Example:
# SUPPORT_SERVER_URL='https://discord.gg/yourinvite'
SUPPORT_SERVER_URL=''

# Channel ID where bot statistics or system reports will be sent.
# 
# Example:
# SUPPORT_STATS_CHANNEL_ID='123456789012345678'
SUPPORT_STATS_CHANNEL_ID=''


# #######################################
# WEBHOOK LOGGER           #
# #######################################

# Avatar URL used for webhook log messages.
# Optional.
# 
# Example:
# WEBHOOK_AVATAR_URL='https://cdn.discordapp.com/...'
WEBHOOK_AVATAR_URL=''

# Display name used for webhook logs.
# 
# Example:
# WEBHOOK_USERNAME='Padio | Logger'
WEBHOOK_USERNAME='Bot Logger'

# Webhook URL for bug reports.
# Example:
# WEBHOOK_URL_BUGS='https://discord.com/api/webhooks/...'
WEBHOOK_URL_BUGS=''

# Webhook URL for user reports.
# Example:
# WEBHOOK_URL_REPORT='https://discord.com/api/webhooks/...'
WEBHOOK_URL_REPORT=''

# Webhook URL for system status logs.
# Example:
# WEBHOOK_URL_STATUS='https://discord.com/api/webhooks/...'
WEBHOOK_URL_STATUS=''


# #######################################
# AUTO STATUS UPDATE          #
# #######################################

# Enables automatic updating of the statistics message.
# true  → Enabled
# false → Disabled
# 
# Example:
# UPDATE_STATS_MESSAGE='true'
UPDATE_STATS_MESSAGE='false'

# Interval for updating the stats message (in milliseconds).
# 
# Default: 3600000 (1 hour)
# 
# Example:
# UPDATE_STATS_INTERVAL='3600000'
UPDATE_STATS_INTERVAL='3600000'


# #######################################
# BOT CONTROL             #
# #######################################

# Array of Discord user IDs with full owner permissions.
# Must be a valid JSON array of strings.
# 
# Example:
# OWNERS='["123456789012345678", "987654321098765432"]'
OWNERS='[]'

# Default language used by the bot (ISO 639-1 format).
# 
# Example:
# en → English
# fa → Persian
# de → German
# 
# Example:
# DEFAULT_LANGUAGE='en'
DEFAULT_LANGUAGE='en'

# Enables crash protection and automatic error handling.
# Recommended for production environments.
# 
# true  → Enabled
# false → Disabled
# 
# Example:
# ANTI_CRASH='true'
ANTI_CRASH='true'

# Restricts the bot to a single guild.
# Useful for development and testing.
# 
# true  → Only one guild allowed
# false → Public multi-guild bot
# 
# Example:
# ONE_GUILD='false'
ONE_GUILD='false'

# Sends runtime errors to Discord via webhook.
# Recommended for production monitoring.
# 
# true  → Enabled
# false → Disabled
# 
# Example:
# LOGGER_ENABLED='true'
LOGGER_ENABLED='true'